{
  "terminal": {
    "font_family": "Monaspace Neon",
    "font_size": 14.5,
    "font_features": {
      "calt": true,
      "ss01": true,
      "ss02": true,
      "ss03": true,
      "zero": true,
      "cv10": true
    },
    "line_height": {
      "custom": 1.2
    },
    "blinking": "off",
    "cursor_shape": "block",
    "option_as_meta": true,
    "max_scroll_history_lines": 10000
  },
  "experimental.theme_overrides": {
    "terminal.background": "#15171a",
    "terminal.foreground": "#d8d6cf",
    "terminal.ansi.black": "#15171a",
    "terminal.ansi.red": "#e86a74",
    "terminal.ansi.green": "#63c794",
    "terminal.ansi.yellow": "#f0c946",
    "terminal.ansi.blue": "#74aeeb",
    "terminal.ansi.magenta": "#b695e8",
    "terminal.ansi.cyan": "#68c5ce",
    "terminal.ansi.white": "#d8d6cf",
    "terminal.ansi.bright_black": "#878d96",
    "terminal.ansi.bright_red": "#f28b94",
    "terminal.ansi.bright_green": "#7ed8a9",
    "terminal.ansi.bright_yellow": "#f7d96d",
    "terminal.ansi.bright_blue": "#93c2f2",
    "terminal.ansi.bright_magenta": "#c8aef0",
    "terminal.ansi.bright_cyan": "#84d6de",
    "terminal.ansi.bright_white": "#eceae4"
  }
}
