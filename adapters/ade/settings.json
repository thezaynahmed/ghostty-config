{
  "terminal.integrated.fontFamily": "'Monaspace Neon', 'Symbols Nerd Font Mono', monospace",
  "terminal.integrated.fontSize": 14.5,
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "\"calt\" on, \"ss01\" on, \"ss02\" on, \"ss03\" on, \"zero\" on, \"cv10\" on",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0.6,
  "terminal.integrated.cursorStyle": "block",
