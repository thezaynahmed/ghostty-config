{
  "terminal.integrated.fontFamily": "'Monaspace Neon', 'MesloLGS NF', 'Symbols Nerd Font Mono', monospace",
  "terminal.integrated.fontSize": 14.5,
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "\"calt\" on, \"ss01\" on, \"ss02\" on, \"ss03\" on, \"zero\" on, \"cv10\" on",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0.6,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.minimumContrastRatio": 3.5,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.external.osxExec": "Ghostty.app",
  "workbench.colorCustomizations": {
    "terminal.background": "#15171a",
    "terminal.foreground": "#d8d6cf",
    "terminalCursor.foreground": "#f0c946",
    "terminalCursor.background": "#111316",
    "terminal.selectionBackground": "#323a46",
    "terminal.ansiBlack": "#15171a",
    "terminal.ansiRed": "#e86a74",
    "terminal.ansiGreen": "#63c794",
    "terminal.ansiYellow": "#f0c946",
    "terminal.ansiBlue": "#74aeeb",
    "terminal.ansiMagenta": "#b695e8",
    "terminal.ansiCyan": "#68c5ce",
    "terminal.ansiWhite": "#d8d6cf",
    "terminal.ansiBrightBlack": "#878d96",
    "terminal.ansiBrightRed": "#f28b94",
    "terminal.ansiBrightGreen": "#7ed8a9",
    "terminal.ansiBrightYellow": "#f7d96d",
    "terminal.ansiBrightBlue": "#93c2f2",
    "terminal.ansiBrightMagenta": "#c8aef0",
    "terminal.ansiBrightCyan": "#84d6de",
    "terminal.ansiBrightWhite": "#eceae4",
    "terminal.selectionForeground": "#eceae4"
  }
}
