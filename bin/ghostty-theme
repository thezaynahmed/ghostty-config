#!/usr/bin/env bash
# ==============================================================================
# ghostty-theme - Instant Ghostty theme switcher with zero restart (SIGUSR2)
# ==============================================================================
set -euo pipefail

REPO_DIR="${GHOSTTY_CONFIG_DIR:-$HOME/.config/ghostty}"
CONFIG_FILE="${GHOSTTY_CONFIG_PATH:-$REPO_DIR/config}"

resolve_theme() {
  local input
  input="$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[-_]/ /g' | xargs)"
  case "$input" in
    batman|gotham) echo "Batman" ;;
    ef\ dream|efdream) echo "Ef-Dream" ;;
    ef\ bio|efbio) echo "Ef-Bio" ;;
    gruvbox|gruvbox\ dark|gruvbox\ material|gruvbox\ material\ dark) echo "Gruvbox Material Dark" ;;
    gruvbox\ medium|gruvbox\ material\ dark\ medium) echo "Gruvbox Material Dark Medium" ;;
    kanagawa|kanagawa\ wave) echo "Kanagawa Wave" ;;
    kanagawa\ dragon|dragon) echo "Kanagawa Dragon" ;;
    matrix|matrix\ ii|matrix\ 2|matrix\ ii\ higher\ contrast) echo "Matrix II Higher Contrast" ;;
    catppuccin|catppuccin\ mocha|mocha) echo "Catppuccin Mocha" ;;
    tokyo|tokyo\ night|tokyo\ night\ storm|tokyonight\ storm) echo "TokyoNight Storm" ;;
    rose\ pine|rosé\ pine|rosepine) echo "Rose Pine" ;;
    rose\ pine\ moon|rosé\ pine\ moon|moon) echo "Rose Pine Moon" ;;
    night\ owl|nightowl) echo "Night Owl" ;;
    modus|modus\ vivendi|modus\ vivendi\ tinted) echo "Modus Vivendi Tinted" ;;
    everforest|everforest\ dark|everforest\ dark\ hard) echo "Everforest Dark Hard" ;;
    dracula) echo "Dracula" ;;
    dracula+|dracula\ plus) echo "Dracula+" ;;
    ayu|ayu\ mirage|mirage) echo "Ayu Mirage" ;;
    ubuntu) echo "Ubuntu" ;;
    *)
      # Fallback: fuzzy match against available ghostty themes
      local match
      match="$(ghostty +list-themes 2>/dev/null | sed -E 's/ \((resources|user)\)//' | grep -i "^${input}$" | head -n 1 || true)"
      if [[ -z "$match" ]]; then
        match="$(ghostty +list-themes 2>/dev/null | sed -E 's/ \((resources|user)\)//' | grep -i "${input}" | head -n 1 || true)"
      fi
      if [[ -n "$match" ]]; then
        echo "$match"
      else
        echo "$1"
      fi
      ;;
  esac
}

list_themes() {
  cat << 'EOF'
Ghostty Theme Switcher

Popular Shortcuts:
  ghostty-theme gruvbox         -> Gruvbox Material Dark (Default)
  ghostty-theme batman          -> Batman
  ghostty-theme ef-dream        -> Ef-Dream
  ghostty-theme kanagawa-wave   -> Kanagawa Wave
  ghostty-theme matrix          -> Matrix II Higher Contrast
  ghostty-theme catppuccin      -> Catppuccin Mocha
  ghostty-theme tokyo-night     -> TokyoNight Storm
  ghostty-theme rose-pine       -> Rose Pine
  ghostty-theme dracula         -> Dracula

Usage:
  ghostty-theme <theme-name>    Switch theme live (no terminal restart needed)
  ghostty-theme --list          List all available themes
  ghostty-theme sync --all      Sync config across all installed editors/tools
EOF
}

if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
  list_themes
  exit 0
fi

if [[ "$1" == "--list" || "$1" == "-l" ]]; then
  ghostty +list-themes
  exit 0
fi

if [[ "$1" == "sync" ]]; then
  shift
  exec "$REPO_DIR/install.sh" "$@"
fi

TARGET_THEME="$(resolve_theme "$*")"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Error: Ghostty config not found at $CONFIG_FILE" >&2
  exit 1
fi

python3 - "$CONFIG_FILE" "$TARGET_THEME" << 'PY'
import sys, re

cfg_path, theme = sys.argv[1], sys.argv[2]
with open(cfg_path, "r", encoding="utf-8") as f:
    content = f.read()

new_content, count = re.subn(
    r"^theme\s*=\s*.*$",
    f"theme = {theme}",
    content,
    count=1,
    flags=re.MULTILINE,
)
if count == 0:
    new_content = f"theme = {theme}\n" + content

with open(cfg_path, "w", encoding="utf-8") as f:
    f.write(new_content)
PY

# Hot-reload Ghostty immediately via SIGUSR2 (no restart required)
pkill -USR2 -x ghostty 2>/dev/null || true

echo "Switched to: $TARGET_THEME (hot-reloaded)"
